{
  "compilerOptions": {
    "module": "ES2020",
    "outDir": "./dist",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["server.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "dist", "src", "lib/supabase/client.ts"]
}
